{
  "name": "decap-oauth-proxy",
  "version": "1.0.0",
  "description": "GitHub OAuth proxy for DecapCMS - reusable across docs-as-code sites",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "test": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "tsx --test 'tests/integration/**/*.test.ts'",
    "test:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --outfile=dist/handler.mjs --format=esm --external:@aws-sdk",
    "dev": "tsx scripts/dev-server.ts",
    "dev:mock": "tsx scripts/dev-server.ts --mock"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1086.0",
    "@aws-sdk/client-ssm": "3.1086.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.162",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "express": "5.2.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
